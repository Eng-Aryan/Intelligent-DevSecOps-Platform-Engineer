PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/devsecops
CLIENT_URL=http://localhost:5173
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES=8h
# 32-byte hex key used to encrypt integration credentials at rest (AES-256-GCM)
ENCRYPTION_KEY=__ENCRYPTION_KEY__
GITHUB_WEBHOOK_SECRET=__WEBHOOK_SECRET__
ALLOW_REGISTRATION=true
# First administrator (created automatically when the database has no users)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@devsecops.local
ADMIN_PASSWORD=__ADMIN_PASSWORD__
# Containers the platform refuses to stop/restart (comma separated)
PROTECTED_CONTAINERS=devsecops-mongo
# Background sync intervals (seconds)
JENKINS_SYNC_SECONDS=60
SONAR_SYNC_SECONDS=300
